<?xml version="1.0" ?>

<sdf version="1.9">

  <world name="my_world">
<scene>
  <ambient>0.5 0.5 0.5 1</ambient>
  <background>0.8 0.8 0.8 1</background>
  <shadows>true</shadows>
</scene>

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>1 1 1 1</diffuse>
<specular>0.1 0.1 0.1 1</specular>
<direction>-0.5 -0.5 -1</direction>
    </light>

    <!-- Ground -->
    <model name="ground_plane">

      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </visual>

      </link>

    </model>
<!-- Wall 1 -->
<model name="wall_1">

  <static>true</static>

  <pose>0 3 0.5 0 0 0</pose>

  <link name="wall_link">

    <visual name="wall_visual">
      <geometry>
        <box>
          <size>6 0.2 1</size>
        </box>
      </geometry>
    </visual>

    <collision name="wall_collision">
      <geometry>
        <box>
          <size>6 0.2 1</size>
        </box>
      </geometry>
    </collision>

  </link>

</model>
<!-- Wall 2 -->
<model name="wall_2">

  <static>true</static>

  <pose>0 -3 0.5 0 0 0</pose>

  <link name="wall_link">

    <visual name="wall_visual">
      <geometry>
        <box>
          <size>6 0.2 1</size>
        </box>
      </geometry>
    </visual>

    <collision name="wall_collision">
      <geometry>
        <box>
          <size>6 0.2 1</size>
        </box>
      </geometry>
    </collision>

  </link>

</model>

<!-- Wall 3 - Left -->
<model name="wall_3">

  <static>true</static>

  <pose>-3 0 0.5 0 0 1.5708</pose>

  <link name="wall_link">

    <visual name="wall_visual">
      <geometry>
        <box>
          <size>6 0.2 1</size>
        </box>
      </geometry>
    </visual>

    <collision name="wall_collision">
      <geometry>
        <box>
          <size>6 0.2 1</size>
        </box>
      </geometry>
    </collision>

  </link>

</model>

<!-- Wall 4 - Right -->
<model name="wall_4">

  <static>true</static>

  <pose>3 0 0.5 0 0 1.5708</pose>

  <link name="wall_link">

    <visual name="wall_visual">
      <geometry>
        <box>
          <size>6 0.2 1</size>
        </box>
      </geometry>
    </visual>

    <collision name="wall_collision">
      <geometry>
        <box>
          <size>6 0.2 1</size>
        </box>
      </geometry>
    </collision>

  </link>

</model>

<!-- Obstacle 1 -->
<model name="box_1">
  <static>true</static>

  <pose>-1 0 0.3 0 0 0</pose>

  <link name="box_link">

    <visual name="box_visual">
      <geometry>
        <box>
          <size>0.6 0.6 0.6</size>
        </box>
      </geometry>
    </visual>

    <collision name="box_collision">
      <geometry>
        <box>
          <size>0.6 0.6 0.6</size>
        </box>
      </geometry>
    </collision>

  </link>
</model>

<!-- Obstacle 2 -->
<model name="box_2">
  <static>true</static>

  <pose>1.5 1 0.4 0 0 0</pose>

  <link name="box_link">

    <visual name="box_visual">
      <geometry>
        <box>
          <size>0.8 0.8 0.8</size>
        </box>
      </geometry>
    </visual>

    <collision name="box_collision">
      <geometry>
        <box>
          <size>0.8 0.8 0.8</size>
        </box>
      </geometry>
    </collision>

  </link>
</model>
<!-- Corridor Wall 1 -->
<model name="corridor_wall_1">
  <static>true</static>

  <pose>0 0.75 0.5 0 0 0</pose>

  <link name="wall_link">

    <visual name="wall_visual">
      <geometry>
        <box>
          <size>3.5 0.15 1</size>
        </box>
      </geometry>
    </visual>

    <collision name="wall_collision">
      <geometry>
        <box>
          <size>3.5 0.15 1</size>
        </box>
      </geometry>
    </collision>

  </link>
</model>

<!-- Corridor Wall 2 -->
<model name="corridor_wall_2">
  <static>true</static>

  <pose>0 -0.75 0.5 0 0 0</pose>

  <link name="wall_link">

    <visual name="wall_visual">
      <geometry>
        <box>
          <size>3.5 0.15 1</size>
        </box>
      </geometry>
    </visual>

    <collision name="wall_collision">
      <geometry>
        <box>
          <size>3.5 0.15 1</size>
        </box>
      </geometry>
    </collision>

  </link>
</model>
  </world>

</sdf>
